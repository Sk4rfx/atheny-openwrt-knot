// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * MikroTik KNOT RB924i-2nD-BT5&BG77, revisao r2. Descrito aqui: CPU, RAM,
 * UART, Ethernet, botao de reset (GPIO16), o azul do LED power (GPIO4), a
 * SPI-NOR do RouterBOOT somente leitura (so a hard_config), a SPI-NAND com
 * as particoes de instalacao (kernel em YAFFS + ubi), o USB (hub, modem
 * BG77, PL2303) e o Wi-Fi. Ainda NAO descritos: Bluetooth (nRF52832), os
 * demais LEDs e o PoE-out da Ether2.
 *
 * Base: qca953x.dtsi direto, e nao qca9533_mikrotik_routerboard-16m.dtsi nem
 * -95x.dtsi, porque estes declaram a particao "firmware" gravavel na NOR e
 * um 74hc595 no CS1, que aqui e a NAND. O PoE de saida (provavel GPIO14,
 * como na 95x) ainda nao foi medido nesta placa. O botao e o LED power foram
 * medidos nesta placa e estao descritos abaixo.
 *
 * Evidencia citada como "medido": leituras numa unidade r2 com OpenWrt em RAM
 * (registradores de GPIO via devmem, sysfs, swconfig, ethtool), 2026-11-23.
 */

#include "qca953x.dtsi"

/* Constantes usadas abaixo: GPIO_ACTIVE_LOW (gpio.h) e KEY_RESTART (input.h). */
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	/*
	 * "qca9531": firmware-type informado pelo RouterOS desta unidade.
	 * Sufixo -r2: as unidades sem revisao vistas ate agora sao "qca9531L" com
	 * 16 MiB de flash (sem a SPI-NAND) e devem ter o seu proprio compatible.
	 */
	compatible = "mikrotik,routerboard-924i-2nd-bt5-bg77-r2", "qca,qca9531";
	/* board KNOT, model RB924i-2nD-BT5&BG77, revision r2 (RouterOS desta unidade) */
	model = "MikroTik RouterBOARD 924i-2nD-BT5&BG77 (KNOT) r2";

	aliases {
		/* ref: qca9533_mikrotik_routerboard-16m.dtsi:9-11 */
		serial0 = &uart;

		/*
		 * LEDs de estado do OpenWrt (etc/diag.sh): o LED power pisca no boot,
		 * pisca rapido no modo failsafe, fica aceso com o sistema pronto e
		 * pisca durante atualizacao. Sem esses aliases o OpenWrt nao teria
		 * nenhum LED para sinalizar o proprio estado.
		 */
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	/*
	 * Botao de reset.
	 * Medido: GPIO16 e entrada; le 1 com o botao solto e 0 enquanto apertado
	 * (3 apertos, so o bit 16 de GPIO_IN muda). Mesmo pino e polaridade da
	 * familia 95x: qca9533_mikrotik_routerboard-16m.dtsi:13-20.
	 *
	 * Efeito no OpenWrt (KEY_RESTART -> /etc/rc.button/reset):
	 *  - sistema ja no ar: toque curto (menos de 1 s) reinicia; segurar 5 s
	 *    ou mais volta as configuracoes de fabrica, mas so com /overlay (OpenWrt
	 *    instalado). Em RAM so o toque curto tem efeito. (A imagem da Atheny
	 *    troca os 5 s por 10 s com o seu proprio /etc/rc.button/reset.)
	 *  - durante o comeco do boot (preinit), o botao pede o modo failsafe.
	 * Cuidado: nunca segurar o botao enquanto o KNOT reinicia ou liga. Nessa
	 * hora quem le o botao e o RouterBOOT, que pode resetar a configuracao do
	 * RouterOS, entrar em Netinstall ou, segurado por 20 s
	 * (reformat-hold-button), reformatar a NAND.
	 */
	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 16 GPIO_ACTIVE_LOW>;
			/* filtra o ruido do contato (ms); valor da 16m.dtsi:20, nao medido */
			debounce-interval = <60>;
		};
	};

	/*
	 * LED ligado direto ao SoC: so o azul do LED 1 (power) e comprovado.
	 * Medido: GPIO4 em 0 acende o azul, em 1 apaga (ida e volta, duas vezes).
	 * Mesmo pino e polaridade do LED power da mAP-2nD
	 * (qca9533_mikrotik_routerboard-map-2nd.dts:21-26); na familia 95x o GPIO4
	 * e um LED verde ativo em nivel alto.
	 *
	 * Ainda nao descritos: os LEDs 2-5 e 8 (Ether1, Ether2, PoE, Wi-Fi, GPS)
	 * ficam num registrador de deslocamento no SPI, sem chip select proprio
	 * (tabela de pinos do firmware de fabrica para esta placa; o latch
	 * provavelmente e o GPIO11). Medido: um teste de GPIOs deixou esses LEDs
	 * presos acesos, o que bate com um registrador que guarda estado. Falta
	 * suporte a esse arranjo no driver SPI. O LED 7 (LTE) e comandado pelo
	 * proprio modem. Os LEDs 6 e 9 nao foram vistos acesos.
	 */
	leds {
		compatible = "gpio-leds";

		led_power: power {
			label = "blue:power";
			gpios = <&gpio 4 GPIO_ACTIVE_LOW>;
			/* acende assim que o driver carrega (como na mAP-2nD) */
			default-state = "on";
		};

		/*
		 * LEDs no registrador (gpio_ssr), todos ativos em baixo pela tabela
		 * de fabrica. Cores e posicoes vistas no teste em RAM (2026-11-24),
		 * cada LED aceso sozinho: ether1 = LED 2, ether2 = 3, poe = 4
		 * (vermelho), gps = 8, wlan = 5.
		 */
		ether1 {
			label = "green:ether1";
			gpios = <&gpio_ssr 0 GPIO_ACTIVE_LOW>;
		};

		ether2 {
			label = "green:ether2";
			gpios = <&gpio_ssr 1 GPIO_ACTIVE_LOW>;
		};

		poe {
			label = "red:poe";
			gpios = <&gpio_ssr 2 GPIO_ACTIVE_LOW>;
		};

		gps {
			label = "green:gps";
			gpios = <&gpio_ssr 3 GPIO_ACTIVE_LOW>;
		};

		wlan {
			label = "green:wlan";
			gpios = <&gpio_ssr 4 GPIO_ACTIVE_LOW>;
		};
	};

	chosen {
		/*
		 * Console serial: ttyS0 a 115200 (baud-rate do RouterBOOT desta
		 * unidade). O kernel le daqui: CONFIG_MIPS_CMDLINE_FROM_DTB=y
		 * (config-6.12:120). Mesmo valor de qca953x.dtsi:11-13.
		 */
		bootargs = "console=ttyS0,115200n8";
	};
};

/*
 * UART do SoC (ttyS0, existe no RouterOS). Os pinos fisicos do console na
 * placa ainda nao foram identificados. ref: qca9531_glinet_gl-s200.dtsi:105-107
 */
&pinmux {
	/* GPIO_OUT_FUNC0[31:24] = 0: GPIO3 como GPIO (RouterBOOT: SPI CS2) */
	cs2_gpio_pins: pinmux_cs2_gpio_pins {
		pinctrl-single,bits = <0x0 0x0 0xff000000>;
	};
};

&uart {
	status = "okay";
};

/*
 * Barramento SPI e a flash NOR do RouterBOOT, SOMENTE LEITURA.
 *
 * Medido (registradores de funcao dos GPIOs): o RouterBOOT deixa tres chip
 * selects do SPI configurados (GPIO5 = CS0, GPIO1 = CS1, GPIO3 = CS2;
 * GPIO6 = CLK, GPIO7 = MOSI, GPIO8 = provavel MISO). Medido pelo ID no
 * dmesg: CS0 = NOR W25Q128JV (16 MiB), CS1 = SPI-NAND W25N01GV. CS2 = o
 * nRF52832 (Bluetooth), pela lista de dispositivos do firmware de fabrica.
 */
&spi {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&cs2_gpio_pins>;

	/*
	 * CS0 e CS1 nativos; CS2 = GPIO3 como GPIO, para dar ao nRF52832 o
	 * tempo de preparacao entre o CS e o primeiro clock (o CS nativo desce
	 * junto com o clock); CS3 = GPIO11, a selecao/latch do registrador de
	 * LEDs. Os dois precisam do patch 941-spi-ar934x-support-gpio-chip-selects.
	 */
	cs-gpios = <0>, <0>, <&gpio 3 GPIO_ACTIVE_LOW>,
		   <&gpio 11 GPIO_ACTIVE_LOW>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;				/* chip select 0 */
		/* 300 MHz (AHB) / 12 = 25 MHz; valor da 92x, mesmo controlador */
		spi-max-frequency = <25000000>;
		/*
		 * Se a NOR tiver mais de 16 MiB e entrar no modo de endereco de
		 * 4 bytes, o kernel tenta devolve-la ao modo de 3 bytes num reboot
		 * ordenado (spi-nor/core.c:3405-3423); sem isso o SoC poderia nao
		 * achar o RouterBOOT num reboot quente (um corte de energia resolve).
		 * Inofensivo em NOR pequena.
		 */
		broken-flash-reset;

		/*
		 * Particoes: o parser "mikrotik,routerboot-partitions" acha a
		 * hard_config (dados de fabrica: MAC base, calibracao do Wi-Fi)
		 * pelo conteudo, sem precisar saber o tamanho da NOR.
		 *
		 * Seguranca, achados da revisao:
		 *  - o proprio conteiner "partitions" e read-only: o parser o
		 *    registra como uma particao do tamanho da NOR inteira
		 *    (routerbootpart.c:225-259; tamanho 0 = NOR inteira) e, sem
		 *    read-only, ela seria gravavel por cima do RouterBOOT. As
		 *    particoes de dentro herdam a falta de permissao (mtdpart.c:71).
		 *    A familia 92x nao tem essa protecao.
		 *  - so a hard_config e descrita nesta primeira leitura: com um
		 *    filho so o parser nao tem como errar por sobreposicao; se
		 *    errasse, o kernel registraria a NOR inteira gravavel
		 *    (mtdpart.c:594-596, mtdcore.c:1109-1118). Routerboot, bios e
		 *    soft_config entram depois de vermos os offsets reais.
		 * Com isso o Linux nao tem nenhum dispositivo gravavel na NOR, e o
		 * OpenWrt passa a ler o MAC verdadeiro (hard_config/mac_base, usado
		 * pelo 02_network).
		 */
		partitions {
			compatible = "mikrotik,routerboot-partitions";
			#address-cells = <1>;
			#size-cells = <1>;
			read-only;

			/* dados de fabrica (MAC, calibracao); nunca gravar */
			hard_config {
				read-only;
			};
		};
	};

	/*
	 * SPI-NAND de 128 MiB: onde o OpenWrt e instalado.
	 * Chip: Winbond W25N01GV no chip select 1, medido (ID ef aa 21 no dmesg,
	 * 128 MiB, 0 blocos ruins, oobavail 24). Tambem em U602 nas fotos internas
	 * da FCC do kit KNOT LR9. Referencia: GL-AR300M, mesmo SoC, SPI-NAND no
	 * CS1 (qca9531_glinet_gl-ar300m.dtsi:141-161).
	 *
	 * Particoes (docs: layout-nand.md, medido em dois dumps desta unidade):
	 *  - kernel (0 - 4 MiB): YAFFS2 com o arquivo "kernel" (ELF), que o
	 *    RouterBOOT abre ao ligar. E a mesma area que o RouterOS usa nesta
	 *    placa (YAFFS2 com tags inband, 2032 B de dados por pagina, medido
	 *    nos dumps). Pelo codigo do yafut, ele escolhe esse mesmo formato
	 *    sozinho porque oobavail = 24 < 28 (falta confirmar gravando).
	 *    Diferente da 92x, aqui nao ha area "booter" no inicio da NAND: o
	 *    RouterBOOT fica na NOR e o RouterOS grava o kernel a partir do
	 *    bloco 0.
	 *  - ubi (4 MiB - 128 MiB): rootfs (squashfs) e rootfs_data.
	 * O kernel so anexa o UBI sozinho quando o primeiro bloco bom do "ubi"
	 * comeca com a assinatura UBI# (patch 490 do generic). Com o RouterOS
	 * ainda na NAND isso nao acontece: a instalacao formata o "ubi" com
	 * ubiformat e grava o kernel no YAFFS com o yafut.
	 */
	flash@1 {
		compatible = "spi-nand";
		reg = <1>;				/* chip select 1 */
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "kernel";
				reg = <0x0 0x400000>;		/* 4 MiB */
			};

			partition@400000 {
				label = "ubi";
				reg = <0x400000 0x7c00000>;	/* 124 MiB */
			};
		};
	};

	/*
	 * Bluetooth LE: Nordic nRF52832 com o firmware HCI (Zephyr) da
	 * MikroTik ja gravado. Pela lista de dispositivos do firmware de
	 * fabrica: "spi-nRF52832" no CS2, 8 MHz, modo SPI 0, interrupcao no
	 * GPIO2. H4 sobre SPI; o nRF ativa a linha enquanto esta ocupado com
	 * um pacote recebido e quando tem pacote para o host. Medido nesta
	 * unidade: com o CS nativo (sem pausa antes do clock), o nRF perde o
	 * primeiro bit; com 5 us, nenhum erro. Driver: kmod-hci-nrf52-spi.
	 */
	bluetooth@2 {
		compatible = "mikrotik,nrf52-hci-spi";
		reg = <2>;				/* chip select 2 */
		spi-max-frequency = <8000000>;
		spi-cs-setup-delay-ns = <5000>;
		irq-gpios = <&gpio 2 GPIO_ACTIVE_LOW>;
	};

	/*
	 * Registrador de deslocamento (74hc595, 8 saidas) dos LEDs e de dois
	 * controles do modem, sem chip select proprio: recebe todo o trafego do
	 * SPI e so copia para as saidas na subida do GPIO11. Pela lista de
	 * dispositivos do firmware de fabrica para esta placa (ficha-knot-r2.md,
	 * fim): "rb400-spi-misc" a 8 MHz, dados {11, 1, 0x7f} = GPIO11, 1
	 * registrador, valor inicial 0x7f. Saidas 0-4: LEDs; 5: hub USB;
	 * 6: uart-select; 7: mpcie-power-off (alimentacao do modem).
	 * Medido em RAM (2026-11-24): os 5 LEDs e o hub USB respondem.
	 */
	gpio_ssr: gpio-ssr@3 {
		compatible = "fairchild,74hc595";
		reg = <3>;				/* CS3 = GPIO11 */
		gpio-controller;
		#gpio-cells = <2>;
		registers-number = <1>;
		spi-max-frequency = <8000000>;

		/*
		 * O driver zera as saidas no probe (modem sem energia por um
		 * instante); o hog religa logo em seguida. Ativo em baixo pela
		 * tabela de fabrica: logico 0 = pino em 1 = modem alimentado.
		 */
		mpcie-power-off-hog {
			gpio-hog;
			gpios = <7 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "mpcie-power-off";
		};

		/*
		 * Saida 5: libera o hub USB (alimentacao ou reset). Fora da tabela
		 * de pinos da r2, mas o valor inicial de fabrica (0x7f) a deixa em
		 * 1; na variante de 16 MiB a mesma saida e "mpcie-power-off",
		 * ativa em baixo. Medido (2026-11-24, OpenWrt em RAM): em 0 o hub
		 * nao responde (error -71) e nada aparece no USB; em 1 o hub, o
		 * PL2303 e o modem enumeram.
		 */
		usb-hub-hog {
			gpio-hog;
			gpios = <5 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "usb-hub";
		};

		/* valor do firmware de fabrica (bit 6 de 0x7f) */
		uart-select-hog {
			gpio-hog;
			gpios = <6 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "uart-select";
		};
	};
};

/*
 * Ethernet: 2 portas 10/100 no switch interno do SoC (Atheros AR8229).
 * Topologia igual a da mAP-2nD (qca9533_mikrotik_routerboard-map-2nd.dts:106-115;
 * commit e1223dbee3: "ETH1 is connected to eth1 and ETH2 is connected to eth0
 * via the embedded switch port 2").
 *
 * Medido no KNOT (so a Ether1 cabeada): a Ether1 e o eth1 do Linux
 * (19000000.eth = GMAC0), ligado ao PHY interno do switch com a troca
 * PHY0/PHY4, link de 100 Mb/s full; o registrador ETH_CFG (0x18070000) mostra
 * o bit SW_PHY_SWAP ligado. A Ether2 fica atras do eth0 (GMAC1, link fixo de
 * 1 Gb/s ate o switch, herdado de qca953x.dtsi:279-292). A Ether2 tem PoE-out,
 * ainda nao controlado por este DTS.
 */
&eth0 {
	status = "okay";

	/* GMAC0 usa o PHY 0 do switch (com a troca abaixo vira a porta da Ether1) */
	phy-handle = <&swphy0>;

	gmac-config {
		device = <&gmac>;
		/* liga SW_PHY_SWAP no ETH_CFG: ag71xx_gmac.c:39-48 (qca,ar9330-gmac) */
		switch-phy-swap = <1>;
	};
};

/*
 * Controles do USB e do modem, exportados para o userspace (/sys/class/gpio),
 * como o usb_power da familia 95x (qca9533_mikrotik_routerboard-95x.dtsi:48-62):
 *  - usb-power: GPIO13, "usb-power-off" ativo em nivel alto na tabela de
 *    pinos do firmware de fabrica, ou seja, power ativo em baixo.
 *    gpio-export,output e o nivel fisico (o driver grava sem inverter): 0,
 *    o mesmo que o RouterBOOT deixa. Medido (2026-11-24): com o pino em 1
 *    desde o boot ou em 0, o hub, o PL2303 e o modem enumeram do mesmo
 *    jeito; quem libera o hub nesta placa e a saida 5 do registrador de
 *    LEDs (gpio_ssr, abaixo).
 *  - lte-reset: GPIO17, reset do modem BG77, ativo em nivel alto; saida 0
 *    (nivel fisico) = modem rodando. Medido
 *    (2026-11-24, OpenWrt em RAM): o RouterBOOT deixa o GPIO17 em 1 e o modem
 *    fica reiniciando (aparece e some do USB a cada ~3,5 s); em 0 ele fica
 *    estavel, responde a AT na interface 2, e o PL2303 tambem aparece.
 */
/ {
	gpio-export {
		compatible = "gpio-export";

		usb_power {
			gpio-export,name = "usb-power";
			gpio-export,output = <0>;
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
		};

		lte_reset {
			gpio-export,name = "lte-reset";
			gpio-export,output = <0>;
			gpios = <&gpio 17 GPIO_ACTIVE_HIGH>;
		};

		/*
		 * PoE de saida da Ether2 (passivo). Medido (2026-11-25, fonte de
		 * 12 V, multimetro entre azul e marrom, sem carga): GPIO14 em 1 =
		 * 11,72 V e o GPIO12 vai a 1; em 0 = 9,68 V (provavel fuga sem
		 * carga, a confirmar com carga) e o GPIO12 volta a 0. Mesmo pino e
		 * polaridade da mAP-2nD (qca9533_mikrotik_routerboard-map-2nd.dts:
		 * 72-76). Desligado por padrao.
		 */
		enable_poe {
			gpio-export,name = "enable-poe";
			gpio-export,output = <0>;
			gpios = <&gpio 14 GPIO_ACTIVE_HIGH>;
		};

		/* acompanha o estado do PoE (medido, ver acima); so leitura */
		poe_status {
			gpio-export,name = "poe-status";
			gpios = <&gpio 12 GPIO_ACTIVE_HIGH>;
		};
	};
};

/*
 * USB 2.0 do SoC. Atras dele (RouterOS desta unidade, /system resource usb):
 * hub de 4 portas 14cd:8608, conversor USB-serial Prolific 067b:23a3
 * (PL2303GC pelo ID, pl2303.h; a marcacao do chip e ilegivel) e o modem
 * Quectel BG77 (2c7c:0700, driver option, mesma entrada do BG95). Mesmos
 * nos da mAP-2nD (qca9533_mikrotik_routerboard-map-2nd.dts:117-123).
 * O modem tambem depende do mpcie-power-off (saida 7 do registrador de
 * LEDs, no SPI, ainda nao descrito), que fica no estado deixado pelo boot.
 * Portas do modem (option): a interface 2 responde a AT (medido com ATI:
 * BG77, revisao BG77LAR02A04). Os numeros ttyUSB dependem da ordem em que
 * o modem e o PL2303 aparecem.
 */
&usb_phy {
	status = "okay";
};

&usb0 {
	status = "okay";
};

/*
 * Wi-Fi 2,4 GHz do proprio SoC (ath9k). Sem EEPROM: a calibracao vem da
 * hard_config (wlan_data) pelo /etc/hotplug.d/firmware/10-ath9k-eeprom.
 * Medido (wlan_data ja decodificada pelo rb_hardconfig, 2026-11-24): 0x1000
 * comeca com 02 02 (versao de EEPROM e de modelo do formato AR9300) e todos
 * os bytes diferentes de 0xFF ficam em 0x1000-0x1440, o mesmo trecho usado
 * pelas outras MikroTik QCA953x. Igual a
 * qca9533_mikrotik_routerboard-map-2nd.dts:100-104.
 */
&wmac {
	status = "okay";

	qca,no-eeprom;
};
