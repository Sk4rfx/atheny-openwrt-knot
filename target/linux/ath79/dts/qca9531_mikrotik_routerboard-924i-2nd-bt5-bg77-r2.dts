// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * MikroTik KNOT RB924i-2nD-BT5&BG77 r2: suporte MINIMO para boot em RAM
 * (initramfs pela Ether1). Sem flash, LEDs, botao, GPIO, USB, Wi-Fi e SPI.
 *
 * Base: qca953x.dtsi direto, e nao qca9533_mikrotik_routerboard-16m.dtsi
 * nem -95x.dtsi, porque estes declaram SPI-NOR de 16 MiB com particao
 * "firmware" gravavel, botao no gpio 16, LEDs e gpio-export de PoE (gpio 14),
 * nada disso comprovado no KNOT.
 */

#include "qca953x.dtsi"

/ {
	/*
	 * evid: firmware-type "qca9531" (ficha 02, C). Sufixo -r2: as unidades
	 * sem revisao sao "qca9531L" com 16 MiB (ficha, comparacao entre
	 * unidades, H) e devem ganhar outro compatible quando houver flash no DTS.
	 */
	compatible = "mikrotik,routerboard-924i-2nd-bt5-bg77-r2", "qca,qca9531";
	/* evid: board KNOT, model RB924i-2nD-BT5&BG77, revision r2 (ficha 02, C) */
	model = "MikroTik RouterBOARD 924i-2nD-BT5&BG77 (KNOT) r2";

	aliases {
		/* ref: qca9533_mikrotik_routerboard-16m.dtsi:9-11 */
		serial0 = &uart;
	};

	chosen {
		/*
		 * evid: baud-rate 115200 do RouterBOOT (ficha 03, C); ttyS0 (ficha 05, C).
		 * O kernel le daqui: CONFIG_MIPS_CMDLINE_FROM_DTB=y (config-6.12:120).
		 * Mesmo valor de qca953x.dtsi:11-13, repetido para a evidencia ficar aqui.
		 */
		bootargs = "console=ttyS0,115200n8";
	};
};

/* evid: ttyS0 existe no RouterOS (ficha 05, C); pinagem do console: desconhecida */
/* ref: qca9531_glinet_gl-s200.dtsi:105-107 */
&uart {
	status = "okay";
};

/*
 * Ethernet: 2 portas 10/100 (ficha 10, C), ambas em "switch1" no RouterOS
 * (ficha 10, C); switch interno do SoC: indicio (irq "switch0", ficha 05, e
 * SoC QCA9531), nao confirmado. PoE-out na Ether2 (ficha 10, C); porta de
 * PoE-in nao documentada pelo fabricante (ficha, I).
 * Topologia copiada da mAP-2nD (QCA9533, 2 portas, PoE-out numa delas):
 * ref: qca9533_mikrotik_routerboard-map-2nd.dts:106-115.
 * O commit que criou a mAP (e1223dbee3) registra: "ETH1 is connected to
 * eth1 and ETH2 is connected to eth0 via the embedded switch port 2".
 *
 * No KNOT a topologia e INFERIDA. Se valer: Ether1 = eth1 do Linux
 * (GMAC0 -> swphy0, com troca PHY0/PHY4) e Ether2 = eth0 do Linux (GMAC1,
 * fixed-link 1000 ate o switch, herdado de qca953x.dtsi:279-292).
 * Confirmar na bancada, so com a Ether1 cabeada: eth1 com carrier e link
 * de 100 Mb/s. O eth0 tem carrier sempre (fixed-link), entao nao prova nada;
 * as portas do switch aparecem em "swconfig dev switch0 show".
 *
 * Alternativa real: padrao 951ui/hEX lite (&eth0 -> swphy4, sem troca;
 * qca9533_mikrotik_routerboard-95x.dtsi:92-96). Sem "gmac-config" o driver
 * nao toca o ETH_CFG (ag71xx_gmac.c:30-31) e a troca fica como o RouterBOOT
 * deixou. Fontes que decidiriam antes do boot: codigo GPL do RouterOS 7 para
 * o RB924; leitura de 0x18070000 num boot sem gmac-config.
 *
 * &eth1 (GMAC1) nao e sobrescrito: fica como em qca953x.dtsi (okay,
 * fixed-link), igual a mAP-2nD nesta versao.
 */
&eth0 {
	status = "okay";

	/* ref: map-2nd.dts:109; wap-2nd.dts:52 (Ether1 unica, mesmo padrao); INFERIDA */
	phy-handle = <&swphy0>;

	gmac-config {
		device = <&gmac>;
		/* ref: map-2nd.dts:111-114; gmac "qca,ar9330-gmac" (qca953x.dtsi:148-151)
		 * -> ag71xx_gmac.c:39-48,119-120; INFERIDA */
		switch-phy-swap = <1>;
	};
};
